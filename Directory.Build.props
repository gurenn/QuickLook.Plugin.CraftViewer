<Project>
  <!--
    公共构建属性（适用于本目录树下所有工程，含 fetch 来的 QuickLook.Common）。
    本机无 .NET SDK / 无 net462 目标包，统一由各 csproj 引用
    Microsoft.NETFramework.ReferenceAssemblies（PrivateAssets=all）解决。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!--
    本机无 net462 目标包的硬性构建约束（总监裁决）：适用于树内全部工程，
    含 fetch 来的 QuickLook.Common（其上游 csproj 自身未带此引用）。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
